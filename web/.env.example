# Claude API key (https://console.anthropic.com/) - used for analysis, questions, prompts and self-checks.
ANTHROPIC_API_KEY=

# Image backend: "local" = our own diffusion server (../generator/server.py), "mock" = placeholder images (no GPU needed).
IMAGE_BACKEND=mock
GENERATOR_URL=http://127.0.0.1:8000

# Optional tuning
# CLAUDE_MODEL=claude-opus-5-5
# PROMPT_WORD_LIMIT=70   # SDXL reads ~75 tokens; raise for FLUX-style models with long text encoders
# DATA_DIR=./data      # where projects, history and images are saved
